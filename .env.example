# Copy to .env on the server. Never commit .env or real credentials.
APP_ENV=production
COOKIE_SECURE=true
PORT=8000

# Set all three paths to the same persistent private SQLite file.
APP_DB_PATH=/data/asfandyar.db
AUTH_DB_PATH=/data/asfandyar.db
SOCIAL_DB_PATH=/data/asfandyar.db

# Generate a Fernet key with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep this key secret and back it up separately; losing it makes vault/MFA secrets unrecoverable.
APP_ENCRYPTION_KEY=REPLACE_WITH_GENERATED_FERNET_KEY

# Generate a random one-time setup key (32+ random bytes); remove after owner setup.
ADMIN_SETUP_KEY=REPLACE_WITH_LONG_RANDOM_ONE_TIME_SECRET

# Blogger official API. Supply a valid server-side OAuth access token and blog ID.
BLOGGER_ACCESS_TOKEN=
BLOGGER_BLOG_ID=

# Future integrations: do not add values until official OAuth/token handling is implemented.
BLOGGER_CLIENT_ID=
BLOGGER_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
X_API_KEY=
X_API_SECRET=
\n# Optional free local AI via Ollama. Install Ollama and pull the chosen model first.\nOLLAMA_BASE_URL=http://127.0.0.1:11434\nOLLAMA_MODEL=llama3.2:3b\n