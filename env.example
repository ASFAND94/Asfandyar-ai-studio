# Copy this file to .env on the server. NEVER commit .env.
APP_ENV=production
COOKIE_SECURE=true

# Generate both values with a cryptographically secure random generator.
# ADMIN_SETUP_KEY is one-time: remove it immediately after first admin setup.
ADMIN_SETUP_KEY=REPLACE_WITH_RANDOM_ONE_TIME_SETUP_SECRET

# OAuth/API secrets belong here or in a dedicated secret manager, never in Git.
BLOGGER_BLOG_ID=
BLOGGER_CLIENT_ID=
BLOGGER_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
X_API_KEY=
X_API_SECRET=
AI_API_KEY=
AI_PROVIDER=
