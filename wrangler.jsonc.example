{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "asfandyar-ai-studio",
  "main": "cloudflare_worker.py",
  "compatibility_date": "2026-11-21",
  "compatibility_flags": ["python_workers"],
  "assets": {
    "directory": "./static/",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "asfandyar-ai-studio-db",
      "database_id": "REPLACE_WITH_REAL_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ]
}
